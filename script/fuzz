#!/bin/bash

set -e

CDPATH="" cd -- "$(dirname -- "$(dirname -- "$0")")"
PATH="$(go env GOROOT)/bin:$(pwd)/bin:$PATH"

mkdir -p tmp

# make a list of all dependencies outside of this repo so they won't be instrumented by go-fuzz
preservers="$(go list -f '{{ join .Deps "\n" }}' | grep -v rjson |  tr '\n' ',')"

GO_FUZZ_VERSION="$(cat script/.go-fuzz-version)"

go get "github.com/dvyukov/go-fuzz@$GO_FUZZ_VERSION"
trap "go mod tidy" EXIT

script/go-fuzz-build -o tmp/fuzz-rjson.zip -preserve "$preservers"

script/go-fuzz -dup -bin tmp/fuzz-rjson.zip -procs 4 -workdir testdata/fuzz
